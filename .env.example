# Application
NODE_ENV=development
PORT=3000
# Set to true when running behind a reverse proxy / load balancer (needed for correct client IPs in rate limiting)
TRUST_PROXY=false
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Defaults to enabled outside production
SWAGGER_ENABLED=true

# PostgreSQL Database (Prisma) - matches docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_erp_dev?schema=public"

# Redis (cache, queues, rate limiting, OTP/session state)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300000

# JWT Authentication
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Mail (leave SMTP_HOST empty in development to print emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Salamat POS & ERP <no-reply@salamatinnovation.com>"

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=salamat-pos-erp

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME="Salamat POS & ERP"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000,http://localhost:5173
