// Prisma reads every .prisma file in this folder as one schema:
//   schema.prisma  generator and datasource (this file)
//   enums.prisma   all enums
//   <domain>.prisma the models of one domain, e.g. auth.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
